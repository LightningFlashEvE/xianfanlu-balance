DATABASE_URL="file:../../packages/database/prisma/dev.db"

# 沙盘一键平衡报告（MiniMax-M3）
# 必须用「API Keys → Create New Secret Key」生成的 sk- 密钥，不要用 ey 开头的 JWT
MINIMAX_API_KEY=

# 与开户站点一致：international（platform.minimax.io）或 china（platform.minimaxi.com）
MINIMAX_REGION=international

# 可选：显式覆盖 base URL（设置后忽略 MINIMAX_REGION）
# MINIMAX_API_BASE_URL=https://api.minimax.io/v1

# 国内部分账号需要个人中心 19 位 Group ID
# MINIMAX_GROUP_ID=

# MINIMAX_MODEL=MiniMax-M3

# MiniMax 通用请求超时（毫秒，默认 180000）
# MINIMAX_REQUEST_TIMEOUT_MS=180000

# 平衡报告专用超时（毫秒，默认 300000=5 分钟；完整 payload + 思考链较慢，优先于上一项）
# BALANCE_REPORT_REQUEST_TIMEOUT_MS=300000

# 平衡报告 AI 单次输出 token（默认 8192；截断时自动用 RETRY。M3 上下文约 1M，输入为完整扫描 payload）
# BALANCE_REPORT_AI_MAX_TOKENS=8192
# BALANCE_REPORT_AI_MAX_TOKENS_RETRY=16384

# 解析仍失败时额外重试一次（关闭深度思考）；默认不设或 0 即保留思考
# BALANCE_REPORT_DISABLE_THINKING=0

# 未来沙盘养成/对手 LLM 代理（未实现）单次输出 token
# SANDBOX_AGENT_MAX_TOKENS=8192

# 平衡报告分步日志（开发环境默认开启；生产可设 BALANCE_REPORT_LOG=1）
# BALANCE_REPORT_LOG=1
